# Data (lives on cluster)
data/raw/*
data/clean/*
notebooks/simdata/*
!data/raw/.gitkeep
!data/clean/.gitkeep

# SLURM logs
slurm/logs/*
!slurm/logs/.gitkeep

# Model output
results/*
!results/.gitkeep

# Ignore compiled Stan models (executable without extension)
*
!**/
!*.*
*.exe

# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.ipynb_checkpoints/

# Environments
.env
.venv/
venv/
env/

# R / Quarto
.Rhistory
.Rapp.history
.RData
.Ruserdata
.Rproj.user/
*_files/
*_cache/
/.quarto/
cleaning/*.html
notebooks/*.html

# Editors
.vscode/
.idea/
*.swp

# Claude Code scratch notes (placed last so the "!*.*" rule above does not re-include it)
CLAUDE.md
